diff --git a/prj.conf b/prj.conf
index e8f5e04..16b5355 100644
--- a/prj.conf
+++ b/prj.conf
@@ -36,6 +36,11 @@ CONFIG_LOG_BACKEND_RTT=y
 CONFIG_LOG_BACKEND_UART=n
 CONFIG_PRINTK=y
 
+# Dataset capture streams ~125 VLOG lines/s over RTT. The stock buffers drop
+# messages at that rate, which would silently punch holes in the dataset.
+CONFIG_LOG_BUFFER_SIZE=8192
+CONFIG_SEGGER_RTT_BUFFER_SIZE_UP=8192
+
 # Nordic UART Service - live voltage stream to the nRF Connect UART console
 CONFIG_BT_NUS=y
 
